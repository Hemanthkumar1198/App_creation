rules_version = '2';

// Paisa Ledger — every user can only ever read or write their own data under /users/{uid}.
// Paste this into Firebase console → Firestore Database → Rules, or deploy with `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function isDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function isMoney(v) {
      return (v is int || v is float) && v >= 0 && v <= 100000000000;
    }
    function isText(v, max) {
      return v is string && v.size() <= max;
    }

    function validTransaction(id) {
      let d = request.resource.data;
      return d.id == id
        && d.type in ['income', 'expense']
        && isMoney(d.amount) && d.amount > 0
        && isDate(d.date)
        && isText(d.category, 40)
        && isText(d.description, 200)
        && isText(d.paymentMethod, 30)
        && isText(d.notes, 1000);
    }

    function validLoan(id) {
      let d = request.resource.data;
      return d.id == id
        && isText(d.borrowerName, 80) && d.borrowerName.size() > 0
        && isText(d.phone, 20)
        && isMoney(d.principal) && d.principal > 0
        && isDate(d.startDate) && isDate(d.dueDate) && d.dueDate > d.startDate
        && (d.interestRate is int || d.interestRate is float) && d.interestRate >= 0
        && d.interestType in ['monthly', 'yearly', 'fixed']
        && d.interestMethod in ['simple', 'compound']
        && d.repayments is list && d.repayments.size() <= 2000
        && isText(d.notes, 1000);
    }

    function validNote(id) {
      let d = request.resource.data;
      return d.id == id && isText(d.name, 80) && d.name.size() > 0 && isText(d.description, 300)
        && d.entries is list && d.entries.size() <= 5000;
    }

    function validPlan(id) {
      let d = request.resource.data;
      return d.id == id && isText(d.name, 80) && d.name.size() > 0 && isText(d.kind, 30)
        && isMoney(d.amount) && d.amount > 0 && isDate(d.startDate)
        && d.frequency in ['monthly', 'quarterly', 'half-yearly', 'yearly', 'one-time']
        && d.payments is list && d.payments.size() <= 5000 && isText(d.notes, 1000);
    }

    // DATA SAFETY: nothing under a user can ever be deleted (delete is always denied).
    // Records are soft-deleted (moved to Trash) and every change keeps the previous version in /history.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && request.resource.data.keys().hasOnly(['settings', 'updatedAt']);
      allow delete: if false;

      match /transactions/{id} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validTransaction(id);
        allow delete: if false;
      }

      match /loans/{id} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validLoan(id);
        allow delete: if false;
      }

      match /notes/{id} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validNote(id);
        allow delete: if false;
      }

      match /plans/{id} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validPlan(id);
        allow delete: if false;
      }

      // Append-only version history: previous copies of edited/deleted records. Never editable or removable.
      match /history/{id} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && request.resource.data.id == id
          && request.resource.data.entity in ['transaction', 'loan', 'note', 'plan'];
        allow update, delete: if false;
      }

      // Append-only audit trail: entries can be added but never edited or removed from the app.
      match /activity/{id} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && request.resource.data.id == id && isText(request.resource.data.label, 300);
        allow update, delete: if false;
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
